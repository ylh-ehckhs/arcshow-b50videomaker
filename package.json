{
  "name": "arcshow-b50videomaker",
  "version": "0.5.17",
  "private": true,
  "description": "arcshow-b50videomaker · 离线 Arcaea Best50 视频生成器",
  "main": "main/bootstrap.cjs",
  "scripts": {
    "start": "node scripts/launch.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/pack.mjs",
    "verify": "node scripts/verify.mjs",
    "resources": "py -3 scripts/prepare-resources.py",
    "resources:check": "py -3 scripts/prepare-resources.py --check-only --emoji"
  },
  "dependencies": {
    "onnxruntime-node": "1.20.1"
  },
  "devDependencies": {
    "electron": "33.3.0",
    "esbuild": "0.21.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
